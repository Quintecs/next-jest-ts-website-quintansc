# Web Analytics: vercel (default) or none. Rebuild after changing NEXT_PUBLIC_*.
NEXT_PUBLIC_ANALYTICS_PROVIDER=vercel
# Custom events require Vercel Pro/Enterprise. Use false for page views only.
NEXT_PUBLIC_ANALYTICS_CUSTOM_EVENTS=true

# Meta Pixel runs independently of Vercel. Paste the numeric Pixel ID here.
# Without a valid ID, no Meta script or events are loaded/sent.
NEXT_PIXEL_ID=G-0HKCLWSF49
NEXT_PUBLIC_META_PIXEL_ENABLED=true
